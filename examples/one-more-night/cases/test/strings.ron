{
    "case.title": "The Test Case",
    "npc_01.name": "Lady Ashby",
    "npc_02.name": "Mr Corwin",
    "npc_03.name": "Hobbs",
    "conv_01.l1": "You asked me here at seven. Say it, then.",
    "conv_01.l2": "I cannot pay you back. Not this year.",
    "conv_01.l3": "Then you will answer for it, Mr Corwin.",
    "conv_01.cover": "Lovely weather for the season, is it not?",
    "conv_02.l1": "You saw nothing in the corridor, Hobbs. Understood?",
    "conv_02.l2": "As you say, sir. Nothing at all.",
    "npc_01.busy": "Not now.",
    "npc_01.no_answer": "I have nothing to say about that.",
    "npc_01.q1": "How is your evening?",
    "npc_01.q1.r1": "Tiresome. I came for the company and found little.",
    "npc_01.f_01.r1": "The display case is empty? That held my late husband's snuffbox.",
    "npc_01.f_01.r2": "It was there this afternoon. I saw it myself.",
    "npc_01.npc_02.r1": "Mr Corwin and I have business. It is no concern of yours.",
    "npc_01.cufflink.r1": "Where did you find that? Those are Mr Corwin's initials.",
    "npc_01.cufflink.r2": "He was wearing the pair at dinner.",
    "npc_02.busy": "Excuse me. I am occupied.",
    "npc_02.no_answer": "I would not know.",
    "npc_02.q1": "Enjoying the house?",
    "npc_02.q1.r1": "A fine house. Full of fine things.",
    "npc_02.q1.r2": "I shall be glad when this evening is over.",
    "npc_02.npc_01.r1": "Lady Ashby? A formidable woman.",
    "npc_02.npc_01.r2": "You heard us. Very well: I owe her money, more than I have.",
    "npc_03.busy": "Beg pardon, I am needed.",
    "npc_03.no_answer": "Couldn't say, I'm sure.",
    "npc_03.q1": "Anything unusual tonight?",
    "npc_03.q1.r1": "Quiet so far.",
    "npc_03.q1.r2": "Mr Corwin came through the service corridor with something under his coat. Guests never come back here.",
    "npc_03.q1.r3": "Her ladyship has seen the empty case. The whole house knows now.",
    "npc_03.f_05.r1": "In the linen basket? I never put it there.",
    "f_01.text": "The display case in the study is empty.",
    "f_02.text": "A note on the desk asks for a meeting in the study at seven, signed C.",
    "f_03.text": "Lady Ashby and Mr Corwin argued in the study at seven about a debt.",
    "f_04.text": "Hobbs saw Mr Corwin in the service corridor with something under his coat.",
    "f_05.text": "A silver snuffbox lies under the linen in the corridor basket.",
    "f_06.text": "The missing snuffbox belonged to Lady Ashby's late husband.",
    "f_07.text": "Mr Corwin told Hobbs to say he saw nothing.",
    "f_09.text": "A cufflink found in the service corridor is Mr Corwin's.",
    "f_10.text": "The study bell was rung at half past seven, after the argument.",
    "f_08.text": "Mr Corwin owes Lady Ashby more than he can pay.",
    "t_ashby.text": "Lady Ashby",
    "t_corwin.text": "Mr Corwin",
    "t_hobbs.text": "Hobbs",
    "t_study.text": "study",
    "t_corridor.text": "service corridor",
    "t_drawing.text": "drawing room",
    "t_box.text": "the snuffbox",
    "t_basket.text": "the linen basket",
    "t_debt.text": "a debt",
    "t_cup.text": "the teacup",
    "d_01.template": "___ took ___ from the study.",
    "d_02.template": "It was hidden in ___ in the ___.",
    "d_f1.template": "The thief is ___.",
    "d_f2.template": "The reason was ___.",
    "finale.r1": "This is absurd. You have no proof.",
    "finale.r2": "He owed me, and he meant to sell what was mine.",
    "finale.end_1": "The snuffbox goes back in its case.",
    "finale.end_2": "The test case is closed.",
    "p_case.name": "Display case",
    "p_case.h1": "The glass is clean. No one forced it.",
    "p_case.h2": "The velvet is pressed flat where something small sat.",
    "p_note.name": "Note",
    "p_note.page_1": "Meet me in the study at seven. Come alone. — C.",
    "p_basket.name": "Linen basket",
    "p_basket.h1": "Folded sheets, still warm from the press.",
    "p_basket.h2": "Under the linen: a silver snuffbox.",
    "p_key.name": "Service key",
    "p_cup.name": "Teacup",
    "p_cufflink.name": "Cufflink",
}
