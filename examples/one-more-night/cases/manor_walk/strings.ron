{
    "case.title": "A walk through the manor",
    "busy": "Not now.",
    "no_answer": "I have nothing to say about that.",
    "who": "Who are you?",
    "npc_01.name": "Lady Marchbank",
    "npc_01.who": "I am resting before dinner. Do sit, if you must.",
    "npc_02.name": "Mr Finch",
    "npc_02.who": "Finch. I look after the family's affairs, such as they are.",
    "npc_03.name": "Tom",
    "npc_03.who": "Footman, same as yesterday. Mind the bell board for me.",
    "npc_04.name": "Colonel Rudge",
    "npc_04.who": "Rudge. I was promised a game and a decent brandy.",
    "npc_05.name": "Miss Vale",
    "npc_05.who": "Call me Cecily. Everyone here is so dreadfully formal.",
    "npc_06.name": "Dr Amory",
    "npc_06.who": "Amory. I am here as a guest tonight, not as a physician.",
    "npc_07.name": "Pike",
    "npc_07.who": "Dinner is at eight. See that the hatch stays clear.",
    "npc_08.name": "Mrs Dunn",
    "npc_08.who": "Out of my kitchen unless you are carrying something.",
    "npc_09.name": "Mrs Calder",
    "npc_09.who": "The linen book does not keep itself. What is it?",
    "npc_10.name": "Stokes",
    "npc_10.who": "The motor is running rough. I will be out here all evening.",
}
