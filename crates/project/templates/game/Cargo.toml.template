[package]
name = "{{name}}"
version = "0.1.0"
edition = "2024"
publish = false

[package.metadata.concerto.editor]
plugins = [
    { package = "concerto-animation-editor", install = "concerto_animation_editor::install" },
]

[lib]

[[bin]]
name = "{{name}}"
path = "src/main.rs"

[dependencies]
concerto = {{concerto}}

[build-dependencies]
concerto-asset-build = {{concerto_asset_build}}
anyhow = "1.0.97"
fs_extra = "1.3.0"
{{workspace}}
